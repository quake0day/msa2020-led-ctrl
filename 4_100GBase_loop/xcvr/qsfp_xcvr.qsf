set_global_assignment -name FAMILY "Stratix 10"
set_global_assignment -name DEVICE 1SG280LN2F43E2VG
set_global_assignment -name TOP_LEVEL_ENTITY qsfp_xcvr
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 23.3
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# 板卡电源/VID (禁止改动)
set_global_assignment -name PWRMGT_SLAVE_DEVICE_TYPE OTHER
set_global_assignment -name PWRMGT_SLAVE_DEVICE0_ADDRESS 60
set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "DIRECT FORMAT"
set_global_assignment -name PWRMGT_DIRECT_FORMAT_COEFFICIENT_M 1
set_global_assignment -name PWRMGT_TRANSLATED_VOLTAGE_VALUE_UNIT MILLIVOLTS
set_global_assignment -name USE_PWRMGT_SCL SDM_IO14
set_global_assignment -name USE_PWRMGT_SDA SDM_IO11
set_global_assignment -name ACTIVE_SERIAL_CLOCK AS_FREQ_115MHZ_IOSC
set_global_assignment -name USE_CONF_DONE SDM_IO16
set_global_assignment -name USE_INIT_DONE SDM_IO0
set_global_assignment -name USE_CVP_CONFDONE SDM_IO13
set_global_assignment -name PRESERVE_UNUSED_XCVR_CHANNEL ON

# 源
set_global_assignment -name VERILOG_FILE qsfp_xcvr.v
set_global_assignment -name SDC_FILE qsfp_xcvr.sdc
set_global_assignment -name IP_FILE ip/eth_xcvr_gxt.ip
set_global_assignment -name IP_FILE ip/eth_xcvr_gxt_pll.ip
set_global_assignment -name IP_FILE ip/eth_xcvr_gxt_buf.ip
set_global_assignment -name IP_FILE ip/eth_xcvr_gx.ip
set_global_assignment -name IP_FILE ip/eth_xcvr_gx_pll.ip
set_global_assignment -name IP_FILE ip/eth_xcvr_reset.ip
set_global_assignment -name IP_FILE ip/rstrel.ip
set_global_assignment -name IP_FILE ip/issp_xcv.ip

# refclk (Bank 1F, 644.53125MHz HCSL)
set_location_assignment PIN_AD34 -to qsfp0_refclk
set_instance_assignment -name IO_STANDARD HCSL -to qsfp0_refclk
# 控制时钟 (Bank 3D, 1.8V)
set_location_assignment PIN_AD6 -to clock_100
set_instance_assignment -name IO_STANDARD "1.8 V" -to clock_100
set_instance_assignment -name GLOBAL_SIGNAL GLOBAL_CLOCK -to clock_100
# QSFP0 TX/RX (lane 0/4/3/1, Plugcat 验证)
set_location_assignment PIN_AG40 -to qsfp0_tx[0]
set_location_assignment PIN_AC40 -to qsfp0_tx[1]
set_location_assignment PIN_AD42 -to qsfp0_tx[2]
set_location_assignment PIN_AF42 -to qsfp0_tx[3]
set_location_assignment PIN_AG36 -to qsfp0_rx[0]
set_location_assignment PIN_AC36 -to qsfp0_rx[1]
set_location_assignment PIN_AB38 -to qsfp0_rx[2]
set_location_assignment PIN_AD38 -to qsfp0_rx[3]
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to qsfp0_tx[*]
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to qsfp0_rx[*]
# LED
set_location_assignment PIN_V6  -to led[0]
set_location_assignment PIN_V7  -to led[1]
set_location_assignment PIN_U7  -to led[2]
set_location_assignment PIN_U8  -to led[3]
set_location_assignment PIN_V8  -to led[4]
set_location_assignment PIN_W8  -to led[5]
set_location_assignment PIN_U9  -to led[6]
set_location_assignment PIN_U10 -to led[7]
set_location_assignment PIN_V11 -to led[8]
set_instance_assignment -name IO_STANDARD "1.8 V" -to led[*]
set_global_assignment -name VERILOG_FILE rtl/eth_phy_10g.v
set_global_assignment -name VERILOG_FILE rtl/eth_phy_10g_rx.v
set_global_assignment -name VERILOG_FILE rtl/eth_phy_10g_rx_ber_mon.v
set_global_assignment -name VERILOG_FILE rtl/eth_phy_10g_rx_frame_sync.v
set_global_assignment -name VERILOG_FILE rtl/eth_phy_10g_rx_if.v
set_global_assignment -name VERILOG_FILE rtl/eth_phy_10g_rx_watchdog.v
set_global_assignment -name VERILOG_FILE rtl/eth_phy_10g_tx.v
set_global_assignment -name VERILOG_FILE rtl/eth_phy_10g_tx_if.v
set_global_assignment -name VERILOG_FILE rtl/eth_xcvr_phy_quad_wrapper.v
set_global_assignment -name VERILOG_FILE rtl/eth_xcvr_phy_wrapper.v
set_global_assignment -name VERILOG_FILE rtl/lfsr.v
set_global_assignment -name VERILOG_FILE rtl/sync_reset.v
set_global_assignment -name VERILOG_FILE rtl/xgmii_baser_dec_64.v
set_global_assignment -name VERILOG_FILE rtl/xgmii_baser_enc_64.v
set_global_assignment -name LAST_QUARTUS_VERSION "23.3.0 Pro Edition"
set_global_assignment -name SDC_FILE sync_reset.sdc
