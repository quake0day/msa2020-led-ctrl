# 实验3: QSFP0 收发器 PRBS 环回 (MSA-2020)
set_global_assignment -name FAMILY "Stratix 10"
set_global_assignment -name TOP_LEVEL_ENTITY qsfp_prbs
set_global_assignment -name DEVICE 1SG280LN2F43E2VG
set_global_assignment -name STRATIXV_CONFIGURATION_SCHEME "ACTIVE SERIAL X4"

# ---- VID / 电源管理 (与官方 blink 一致, 切勿修改) ----
set_global_assignment -name PWRMGT_SLAVE_DEVICE_TYPE OTHER
set_global_assignment -name PWRMGT_SLAVE_DEVICE0_ADDRESS 60
set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "DIRECT FORMAT"
set_global_assignment -name PWRMGT_DIRECT_FORMAT_COEFFICIENT_M 1
set_global_assignment -name PWRMGT_TRANSLATED_VOLTAGE_VALUE_UNIT MILLIVOLTS
set_global_assignment -name USE_PWRMGT_SCL SDM_IO14
set_global_assignment -name USE_PWRMGT_SDA SDM_IO11
set_global_assignment -name ACTIVE_SERIAL_CLOCK AS_FREQ_115MHZ_IOSC
set_global_assignment -name USE_CONF_DONE SDM_IO16
set_global_assignment -name USE_INIT_DONE SDM_IO0
set_global_assignment -name USE_CVP_CONFDONE SDM_IO13

# ---- 文件 ----
set_global_assignment -name VERILOG_FILE qsfp_prbs.v
set_global_assignment -name SYSTEMVERILOG_FILE prbs31.sv
set_global_assignment -name SDC_FILE qsfp_prbs.sdc
set_global_assignment -name IP_FILE ip/rstctrl0.ip

set_global_assignment -name OPTIMIZATION_MODE BALANCED
set_global_assignment -name POWER_APPLY_THERMAL_MARGIN ADDITIONAL
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name NUM_PARALLEL_PROCESSORS 8

# ---- 时钟与 LED ----
set_instance_assignment -name IO_STANDARD "1.8 V" -to clk100M
set_location_assignment PIN_AD6 -to clk100M
set_instance_assignment -name IO_STANDARD "1.8 V" -to LED[0]
set_instance_assignment -name IO_STANDARD "1.8 V" -to LED[1]
set_instance_assignment -name IO_STANDARD "1.8 V" -to LED[2]
set_instance_assignment -name IO_STANDARD "1.8 V" -to LED[3]
set_instance_assignment -name IO_STANDARD "1.8 V" -to LED[4]
set_instance_assignment -name IO_STANDARD "1.8 V" -to LED[5]
set_instance_assignment -name IO_STANDARD "1.8 V" -to LED[6]
set_instance_assignment -name IO_STANDARD "1.8 V" -to LED[7]
set_instance_assignment -name IO_STANDARD "1.8 V" -to LED[8]
set_location_assignment PIN_V6  -to LED[0]
set_location_assignment PIN_V7  -to LED[1]
set_location_assignment PIN_U7  -to LED[2]
set_location_assignment PIN_U8  -to LED[3]
set_location_assignment PIN_V8  -to LED[4]
set_location_assignment PIN_W8  -to LED[5]
set_location_assignment PIN_U9  -to LED[6]
set_location_assignment PIN_U10 -to LED[7]
set_location_assignment PIN_V11 -to LED[8]

# ---- QSFP0 (Plugcat 验证: Bank 1F, lane 顺序已按 ch 0/4/3/1 排列) ----
# 参考时钟 644.53125 MHz HCSL
set_location_assignment PIN_AD34 -to qsfp0_refclk
set_location_assignment PIN_AD33 -to "qsfp0_refclk(n)"
set_instance_assignment -name IO_STANDARD HCSL -to qsfp0_refclk
# TX
set_location_assignment PIN_AG40 -to qsfp0_tx[0]
set_location_assignment PIN_AG39 -to "qsfp0_tx[0](n)"
set_location_assignment PIN_AC40 -to qsfp0_tx[1]
set_location_assignment PIN_AC39 -to "qsfp0_tx[1](n)"
set_location_assignment PIN_AD42 -to qsfp0_tx[2]
set_location_assignment PIN_AD41 -to "qsfp0_tx[2](n)"
set_location_assignment PIN_AF42 -to qsfp0_tx[3]
set_location_assignment PIN_AF41 -to "qsfp0_tx[3](n)"
set_instance_assignment -name IO_STANDARD "HIGH SPEED DIFFERENTIAL I/O" -to qsfp0_tx[*]
# RX
set_location_assignment PIN_AG36 -to qsfp0_rx[0]
set_location_assignment PIN_AG35 -to "qsfp0_rx[0](n)"
set_location_assignment PIN_AC36 -to qsfp0_rx[1]
set_location_assignment PIN_AC35 -to "qsfp0_rx[1](n)"
set_location_assignment PIN_AB38 -to qsfp0_rx[2]
set_location_assignment PIN_AB37 -to "qsfp0_rx[2](n)"
set_location_assignment PIN_AD38 -to qsfp0_rx[3]
set_location_assignment PIN_AD37 -to "qsfp0_rx[3](n)"
set_instance_assignment -name IO_STANDARD "CURRENT MODE LOGIC (CML)" -to qsfp0_rx[*]
set_global_assignment -name LAST_QUARTUS_VERSION "23.3.0 Pro Edition"
set_global_assignment -name IP_FILE ip/rstrel.ip

set_global_assignment -name IP_FILE ip/issp_xcvr.ip
set_global_assignment -name IP_FILE ip/xcvr_sys/xcvr_sys_phy.ip
set_global_assignment -name VERILOG_FILE xcvr_sys/synth/xcvr_sys.v
set_global_assignment -name IP_FILE ip/xcvr_sys/xcvr_sys_atx0.ip
set_global_assignment -name IP_FILE ip/xcvr_sys/xcvr_sys_atx1.ip
set_global_assignment -name QSYS_FILE xcvr_sys.qsys
set_global_assignment -name PRESERVE_UNUSED_XCVR_CHANNEL ON
set_global_assignment -name IP_FILE ip/xcvr_sys/xcvr_sys_phyf.ip
set_global_assignment -name IP_FILE ip_ed/ip/phy_ed/phy_ed_phy.ip
set_global_assignment -name QSYS_FILE ip_ed/phy_ed.qsys
