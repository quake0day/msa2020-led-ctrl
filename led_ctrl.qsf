# -- 板级 I2C --
set_instance_assignment -name IO_STANDARD "3.0-V LVTTL" -to i2c_scl
set_instance_assignment -name IO_STANDARD "3.0-V LVTTL" -to i2c_sda
set_location_assignment PIN_AC28 -to i2c_scl
set_location_assignment PIN_AB28 -to i2c_sda
# ---- DDR4 PINS END ----
set_global_assignment -name IP_FILE ip/jtag_sys/jtag_sys_clk_br.ip
set_global_assignment -name IP_FILE ip/jtag_sys/jtag_sys_rst_br.ip
set_global_assignment -name IP_FILE ip/jtag_sys/jtag_sys_jtag_master.ip
set_global_assignment -name IP_FILE ip/jtag_sys/jtag_sys_issp.ip
