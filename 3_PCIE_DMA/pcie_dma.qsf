set_global_assignment -name FAMILY "Stratix 10"
set_global_assignment -name DEVICE 1SG280LN2F43E2VG
set_global_assignment -name TOP_LEVEL_ENTITY pcie_dma
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 23.3
set_global_assignment -name LAST_QUARTUS_VERSION "23.3.0 Pro Edition"
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# ---- 板卡电源/VID (与官方 blink 一致, 禁止改动; 无 CVP_CONFDONE 以便 JTAG 烧录) ----
set_global_assignment -name PWRMGT_SLAVE_DEVICE_TYPE OTHER
set_global_assignment -name PWRMGT_SLAVE_DEVICE0_ADDRESS 60
set_global_assignment -name PWRMGT_VOLTAGE_OUTPUT_FORMAT "DIRECT FORMAT"
set_global_assignment -name PWRMGT_DIRECT_FORMAT_COEFFICIENT_M 1
set_global_assignment -name PWRMGT_TRANSLATED_VOLTAGE_VALUE_UNIT MILLIVOLTS
set_global_assignment -name USE_PWRMGT_SCL SDM_IO14
set_global_assignment -name USE_PWRMGT_SDA SDM_IO11
set_global_assignment -name ACTIVE_SERIAL_CLOCK AS_FREQ_115MHZ_IOSC
set_global_assignment -name USE_CONF_DONE SDM_IO16
set_global_assignment -name USE_INIT_DONE SDM_IO0
set_global_assignment -name ON_CHIP_BITSTREAM_DECOMPRESSION ON

# ---- 设计文件 (hip_ast + Corundum TLP 栈 + AXI-Lite RAM, 不依赖 qsys 互连) ----
set_global_assignment -name IP_FILE ip/pcie.ip
set_global_assignment -name IP_FILE ip/reset_release.ip
set_global_assignment -name IP_FILE ip/iopll_100mhz.ip
set_global_assignment -name VERILOG_FILE H:/led_ctrl/05_corundum/corundum/fpga/lib/eth/lib/axis/rtl/sync_reset.v
set_global_assignment -name VERILOG_FILE rtl/pcie_dma.v
set_global_assignment -name SDC_FILE pcie_dma.sdc
# Corundum PCIe TLP 栈 (Avalon-ST -> TLP -> AXI-Lite)
set_global_assignment -name VERILOG_FILE H:/led_ctrl/05_corundum/corundum/fpga/lib/pcie/rtl/pcie_s10_if.v
set_global_assignment -name VERILOG_FILE H:/led_ctrl/05_corundum/corundum/fpga/lib/pcie/rtl/pcie_s10_if_rx.v
set_global_assignment -name VERILOG_FILE H:/led_ctrl/05_corundum/corundum/fpga/lib/pcie/rtl/pcie_s10_if_tx.v
set_global_assignment -name VERILOG_FILE H:/led_ctrl/05_corundum/corundum/fpga/lib/pcie/rtl/pcie_s10_cfg.v
set_global_assignment -name VERILOG_FILE H:/led_ctrl/05_corundum/corundum/fpga/lib/pcie/rtl/pcie_tlp_demux.v
set_global_assignment -name VERILOG_FILE H:/led_ctrl/05_corundum/corundum/fpga/lib/pcie/rtl/pcie_tlp_fifo.v
set_global_assignment -name VERILOG_FILE H:/led_ctrl/05_corundum/corundum/fpga/lib/pcie/rtl/pcie_tlp_fifo_mux.v
set_global_assignment -name VERILOG_FILE H:/led_ctrl/05_corundum/corundum/fpga/lib/pcie/rtl/pcie_tlp_fifo_raw.v
set_global_assignment -name VERILOG_FILE H:/led_ctrl/05_corundum/corundum/fpga/lib/pcie/rtl/pcie_tlp_fc_count.v
set_global_assignment -name VERILOG_FILE H:/led_ctrl/05_corundum/corundum/fpga/lib/pcie/rtl/pcie_axil_master_minimal.v
set_global_assignment -name VERILOG_FILE H:/led_ctrl/05_corundum/corundum/fpga/lib/axi/rtl/axil_ram.v

# ---- PCIe Gen3x8 引脚 (A-2020, lane 0..7; refclk AM34 HCSL; perst AC26) ----
set_location_assignment PIN_BB34 -to pcie_tx[0]
set_location_assignment PIN_BA36 -to pcie_tx[1]
set_location_assignment PIN_BB38 -to pcie_tx[2]
set_location_assignment PIN_AY38 -to pcie_tx[3]
set_location_assignment PIN_BA40 -to pcie_tx[4]
set_location_assignment PIN_AV38 -to pcie_tx[5]
set_location_assignment PIN_AW40 -to pcie_tx[6]
set_location_assignment PIN_AV42 -to pcie_tx[7]
set_location_assignment PIN_AV30 -to pcie_rx[0]
set_location_assignment PIN_AY30 -to pcie_rx[1]
set_location_assignment PIN_BB30 -to pcie_rx[2]
set_location_assignment PIN_AW32 -to pcie_rx[3]
set_location_assignment PIN_BA32 -to pcie_rx[4]
set_location_assignment PIN_AY34 -to pcie_rx[5]
set_location_assignment PIN_AU36 -to pcie_rx[6]
set_location_assignment PIN_AW36 -to pcie_rx[7]
set_location_assignment PIN_AM34 -to pcie_refclk
set_instance_assignment -name IO_STANDARD HCSL -to pcie_refclk
set_location_assignment PIN_AC26 -to pcie_perstn
set_instance_assignment -name IO_STANDARD "3.0-V LVTTL" -to pcie_perstn
set_location_assignment PIN_AD6 -to usr_refclk0
set_instance_assignment -name IO_STANDARD "1.8 V" -to usr_refclk0 -entity pcie_dma

# ---- 状态 LED (绿) ----
set_location_assignment PIN_V6 -to led_user_grn[0]
set_location_assignment PIN_V7 -to led_user_grn[1]
set_instance_assignment -name IO_STANDARD "1.8 V" -to led_user_grn[*]
set_global_assignment -name BOARD default
set_global_assignment -name IP_FILE ../9_ddr4_framebuffer/ip/jtag_sys/jtag_sys_issp2.ip
set_global_assignment -name IP_FILE ../9_ddr4_framebuffer/ip/jtag_sys/jtag_sys_jtag_master.ip
set_global_assignment -name IP_FILE ../9_ddr4_framebuffer/ip/jtag_sys/jtag_sys_issp.ip
set_global_assignment -name IP_FILE ../9_ddr4_framebuffer/ip/jtag_sys/jtag_sys_mm_bridge.ip
set_global_assignment -name IP_FILE ../9_ddr4_framebuffer/ip/jtag_sys/jtag_sys_rst_release.ip
set_global_assignment -name IP_FILE ../9_ddr4_framebuffer/ip/jtag_sys/jtag_sys_clk_br.ip
set_global_assignment -name IP_FILE ../9_ddr4_framebuffer/ip/jtag_sys/jtag_sys_emif0.ip
set_global_assignment -name IP_FILE ../9_ddr4_framebuffer/ip/jtag_sys/jtag_sys_i2c.ip
set_global_assignment -name IP_FILE ../9_ddr4_framebuffer/ip/jtag_sys/jtag_sys_rst_br.ip
set_global_assignment -name IP_FILE ../9_ddr4_framebuffer/ip/jtag_sys/jtag_sys_emif1.ip
set_global_assignment -name QSYS_FILE ../9_ddr4_framebuffer/jtag_sys.qsys
